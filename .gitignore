# Secrets
.vscode/mcp.json
.env

# WordPress core files (large, auto-installed by Docker — not tracked)
# Ignore core directories but track our custom theme
wordpress/wp-admin/
wordpress/wp-includes/
wordpress/wp-content/plugins/
wordpress/wp-content/uploads/
wordpress/wp-content/upgrade/
wordpress/wp-content/cache/
# Ignore WP root PHP/config files (generated)
wordpress/*.php
wordpress/*.txt
wordpress/*.html
wordpress/xmlrpc.php
wordpress/wp-login.php
wordpress/wp-cron.php
wordpress/wp-blog-header.php
wordpress/wp-config.php
wordpress/wp-config-sample.php
wordpress/wp-load.php
wordpress/wp-mail.php
wordpress/wp-settings.php
wordpress/wp-signup.php
wordpress/wp-trackback.php
wordpress/index.php
# Ignore other WP themes (keep only ours)
wordpress/wp-content/themes/twentytwentythree/
wordpress/wp-content/themes/twentytwentyfour/
wordpress/wp-content/themes/twentytwentyfive/
